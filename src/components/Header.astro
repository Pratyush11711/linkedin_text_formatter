---
---

<header class="sticky top-0 z-50 bg-canvas/95 backdrop-blur-md border-b border-hairline transition-colors h-[64px] flex items-center">
  <div class="max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between">
    
    <!-- Brand Logo & Tagline -->
    <a href="/" class="flex items-center gap-2.5 group shrink-0">
      <div class="w-8 h-8 rounded-md bg-ink flex items-center justify-center text-on-primary font-bold text-sm shadow-2xs group-hover:scale-105 transition-transform">
        in
      </div>
      <div class="flex flex-col justify-center">
        <span class="text-sm font-bold tracking-tight text-ink flex items-center gap-1.5 leading-none">
          LinkedIn Text Formatter
        </span>
        <span class="text-[11px] font-mono text-mute tracking-tight mt-0.5 leading-none hidden sm:inline">
          Free Unicode Font Generator
        </span>
      </div>
    </a>

    <!-- Navigation Right Menu -->
    <nav class="flex items-center gap-2 sm:gap-3">
      <a 
        href="#how-it-works"
        class="text-xs font-medium text-body hover:text-ink transition-colors px-3 py-1.5 rounded-md hover:bg-canvas-soft hidden md:inline-flex"
      >
        How It Works
      </a>
      <a 
        href="#supported-styles"
        class="text-xs font-medium text-body hover:text-ink transition-colors px-3 py-1.5 rounded-md hover:bg-canvas-soft hidden md:inline-flex"
      >
        Font Styles
      </a>
      <a 
        href="#faq"
        class="text-xs font-medium text-body hover:text-ink transition-colors px-3 py-1.5 rounded-md hover:bg-canvas-soft hidden sm:inline-flex"
      >
        FAQ
      </a>

      <!-- Trust Pill -->
      <div class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-semibold text-ink bg-canvas-soft border border-hairline rounded-md">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>100% Free</span>
      </div>

      <!-- Vercel Theme Toggle Button (Sun/Moon) -->
      <button
        id="theme-toggle-btn"
        type="button"
        aria-label="Toggle dark mode"
        class="p-2 text-body hover:text-ink bg-canvas-soft hover:bg-hairline border border-hairline rounded-md transition-all ml-1 flex items-center justify-center cursor-pointer"
      >
        <!-- Sun Icon (shown in dark mode) -->
        <svg id="sun-icon" class="w-4 h-4 hidden dark:block text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon Icon (shown in light mode) -->
        <svg id="moon-icon" class="w-4 h-4 block dark:hidden text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>
    </nav>

  </div>
</header>

<script is:inline>
  document.getElementById('theme-toggle-btn')?.addEventListener('click', function() {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });
</script>

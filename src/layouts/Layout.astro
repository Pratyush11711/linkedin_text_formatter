---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { FAQS } from '../components/FaqAccordion.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Free LinkedIn Text Formatter — Bold, Italic & Unicode Font Generator",
  description = "The ultimate free linkedin text formatter tool. Convert post text into bold, italic, script, and list fonts. Works as an online text formatter for LinkedIn, Instagram, Facebook, Discord, and WhatsApp."
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://freelinkedintextformatter.com');

// JSON-LD Structured Data for Software Application
const softwareAppSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "LinkedIn Text Formatter",
  "operatingSystem": "All",
  "applicationCategory": "BusinessApplication",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": description,
  "url": "https://freelinkedintextformatter.com"
};

// Single Source of Truth JSON-LD Structured Data for FAQPage
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": FAQS.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-9Y6GJET48K"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-9Y6GJET48K');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="linkedin text formatter, free text formatter, text formatter, instagram text formatter, facebook text formatter, text formatter online, online text formatter, discord text formatter, linked in text formatter, linkedin text formatter tool, linkedin text formatter free, text formatter for linkedin, whatsapp text formatter" />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="LinkedIn Text Formatter" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Free LinkedIn Text Formatter" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content="https://freelinkedintextformatter.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Free LinkedIn Text Formatter Tool Preview" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="https://freelinkedintextformatter.com/og-image.png" />

    <!-- Fonts: Geist / Inter & Geist Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Anti-FOUC Dark Mode Theme Detection Script -->
    <script is:inline>
      (function() {
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(softwareAppSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>
  <body class="bg-canvas-soft text-ink font-sans antialiased min-h-screen flex flex-col selection:bg-primary selection:text-on-primary">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

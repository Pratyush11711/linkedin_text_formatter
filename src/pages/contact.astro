---
import Layout from '../layouts/Layout.astro';
import { ContactForm } from '../components/ContactForm';
---

<Layout 
  title="Contact Us — Free LinkedIn Text Formatter"
  description="Get in touch with the Free LinkedIn Text Formatter team. Have questions, feedback, or feature requests? Contact us anytime."
>
  <section class="py-12 md:py-16 bg-canvas">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      {/* Header */}
      <div class="mb-10 border-b border-hairline pb-8 text-center max-w-2xl mx-auto">
        <span class="text-xs font-mono text-ink bg-canvas-soft border border-hairline px-3 py-1 rounded-md uppercase tracking-wider">
          Support & Feedback
        </span>
        <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-ink mt-3">
          Contact Us
        </h1>
        <p class="text-body text-xs sm:text-sm font-sans mt-2 leading-relaxed">
          Have a question, feedback, or feature request? We'd love to hear from you. Send us a message and our team will get back to you within 24–48 hours.
        </p>
      </div>

      {/* Grid Layout: Contact Form + Direct Info */}
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
        
        {/* Left: Contact Form Component */}
        <div class="md:col-span-7">
          <ContactForm client:load />
        </div>

        {/* Right: Direct Info Card */}
        <div class="md:col-span-5 space-y-6">
          
          <div class="bg-canvas-soft border border-hairline rounded-xl p-6 shadow-2xs">
            <h2 class="text-base font-bold text-ink mb-2">Direct Email Support</h2>
            <p class="text-xs text-body leading-relaxed mb-4">
              For general inquiries, partnership opportunities, or technical feedback, feel free to send us a direct email:
            </p>
            <div class="p-3 bg-canvas border border-hairline rounded-lg font-mono text-xs text-ink break-all">
              <a href="mailto:support@freelinkedintextformatter.com" class="text-accent hover:underline">
                support@freelinkedintextformatter.com
              </a>
            </div>
          </div>

          <div class="bg-canvas-soft border border-hairline rounded-xl p-6 shadow-2xs">
            <h2 class="text-base font-bold text-ink mb-2">Response Time</h2>
            <p class="text-xs text-body leading-relaxed">
              We aim to respond to all inquiries within <strong>24 to 48 business hours</strong>.
            </p>
          </div>

          <div class="bg-canvas-soft border border-hairline rounded-xl p-6 shadow-2xs">
            <h2 class="text-base font-bold text-ink mb-2">Looking for Help?</h2>
            <p class="text-xs text-body leading-relaxed">
              Check out our <a href="/#faq" class="text-accent hover:underline font-semibold">Frequently Asked Questions</a> for instant answers to common post formatting and image dimension questions.
            </p>
          </div>

        </div>

      </div>

    </div>
  </section>
</Layout>

---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="404 Page Not Found — Free LinkedIn Text Formatter"
  description="The page you are looking for does not exist or has been moved. Return to the main Free LinkedIn Text Formatter tool to format post text."
>
  <section class="py-16 md:py-24 bg-canvas flex items-center justify-center min-h-[70vh]">
    <div class="max-w-2xl mx-auto px-4 text-center">
      
      <!-- Monospaced Error Code Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-canvas-soft border border-hairline font-mono text-xs font-semibold text-ink mb-6">
        <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
        <span>ERROR 404 — PAGE NOT FOUND</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-ink mb-4 font-sans">
        Lost in Formatting?
      </h1>

      <p class="text-body text-sm sm:text-base font-sans leading-relaxed max-w-md mx-auto mb-8">
        The page or post link you followed doesn't exist or has been moved. Don't worry, your text formatting workflow is just one click away.
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-12">
        <a 
          href="/" 
          class="w-full sm:w-auto px-6 py-3 bg-ink text-on-primary font-bold text-xs rounded-lg shadow-2xs hover:opacity-90 transition-all flex items-center justify-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>Return to Text Formatter</span>
        </a>
        <a 
          href="/contact" 
          class="w-full sm:w-auto px-6 py-3 bg-canvas-soft text-ink border border-hairline font-semibold text-xs rounded-lg hover:bg-hairline/50 transition-all"
        >
          Contact Support
        </a>
      </div>

      <!-- Quick Helpful Links -->
      <div class="pt-8 border-t border-hairline text-xs text-mute">
        <p class="font-semibold text-ink uppercase tracking-wider mb-3">Popular Links</p>
        <div class="flex flex-wrap justify-center gap-4 text-body">
          <a href="/#how-it-works" class="hover:text-ink hover:underline">How It Works</a>
          <span>•</span>
          <a href="/#supported-styles" class="hover:text-ink hover:underline">Font Styles</a>
          <span>•</span>
          <a href="/about" class="hover:text-ink hover:underline">About Us</a>
          <span>•</span>
          <a href="/#faq" class="hover:text-ink hover:underline">FAQ</a>
        </div>
      </div>

    </div>
  </section>
</Layout>

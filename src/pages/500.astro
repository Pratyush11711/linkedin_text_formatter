---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="500 Internal Error — Free LinkedIn Text Formatter"
  description="An unexpected server error occurred. Please refresh or return to the main Free LinkedIn Text Formatter application."
>
  <section class="py-16 md:py-24 bg-canvas flex items-center justify-center min-h-[70vh]">
    <div class="max-w-2xl mx-auto px-4 text-center">
      
      <!-- Monospaced Error Code Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-canvas-soft border border-hairline font-mono text-xs font-semibold text-ink mb-6">
        <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
        <span>ERROR 500 — INTERNAL SERVER ERROR</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-ink mb-4 font-sans">
        Something Went Wrong
      </h1>

      <p class="text-body text-sm sm:text-base font-sans leading-relaxed max-w-md mx-auto mb-8">
        We encountered an unexpected glitch while loading this route. Because our formatting tool works 100% locally in your browser, your post drafts are safe.
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-12">
        <a 
          href="/" 
          class="w-full sm:w-auto px-6 py-3 bg-ink text-on-primary font-bold text-xs rounded-lg shadow-2xs hover:opacity-90 transition-all flex items-center justify-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          <span>Reload Application</span>
        </a>
        <a 
          href="/contact" 
          class="w-full sm:w-auto px-6 py-3 bg-canvas-soft text-ink border border-hairline font-semibold text-xs rounded-lg hover:bg-hairline/50 transition-all"
        >
          Report Error
        </a>
      </div>

      <!-- System Diagnostic Note -->
      <div class="p-4 bg-canvas-soft border border-hairline rounded-xl max-w-md mx-auto text-left font-mono text-xs text-mute">
        <div class="flex items-center justify-between border-b border-hairline pb-2 mb-2 font-bold text-ink">
          <span>Diagnostic Note</span>
          <span>HTTP 500</span>
        </div>
        <p class="leading-relaxed">
          If this issue persists, try clearing your browser cache or switching theme preferences in the navigation bar.
        </p>
      </div>

    </div>
  </section>
</Layout>

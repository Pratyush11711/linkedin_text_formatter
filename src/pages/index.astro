---
import Layout from '../layouts/Layout.astro';
import { EditorIsland } from '../components/Formatter/EditorIsland';
import SeoContent from '../components/SeoContent.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
---

<Layout 
  title="Free LinkedIn Text Formatter — Bold, Italic & Unicode Generator"
  description="The ultimate free linkedin text formatter tool. Convert post text into bold, italic, script, and list fonts. Works as an online text formatter for LinkedIn, Instagram, Facebook, Discord, and WhatsApp."
>
  {/* Hero Mesh Gradient Header */}
  <section class="relative overflow-hidden pt-12 pb-8 md:pt-16 md:pb-12 mesh-gradient-bg border-b border-hairline">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      
      {/* Badge / Pill */}
      <div class="inline-flex items-center gap-2 px-3 py-1 text-xs font-mono font-medium text-ink bg-canvas border border-hairline rounded-md shadow-2xs mb-6">
        <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
        <span>100% Free Text Formatter Tool Online</span>
      </div>

      {/* Main Single H1 Heading */}
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-ink max-w-4xl mx-auto leading-none">
        LinkedIn Text Formatter
      </h1>

      {/* Subtitle */}
      <p class="text-base sm:text-lg text-body max-w-2xl mx-auto mt-4 leading-relaxed font-sans">
        Free <span class="font-semibold text-ink">online text formatter</span> to style LinkedIn post text with <span class="font-semibold text-ink">bold, italic, script, and lists</span>. Highlight any selection to format specific words, preview the live LinkedIn <span class="font-semibold text-ink">"...see more" cutoff limit</span>, and copy in one click.
      </p>

    </div>
  </section>

  {/* Main Interactive Formatter Island */}
  <section class="-mt-4 relative z-20">
    <EditorIsland client:load />
  </section>

  {/* Educational Content & Tutorial */}
  <SeoContent />

  {/* FAQ Section */}
  <FaqAccordion />
</Layout>
